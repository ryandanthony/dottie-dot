window-decoration = client
# Ghostty's bundled fontconfig only exposes the short family name ("NFM"); the
# long "JetBrainsMono Nerd Font Mono" silently fell back to Hack. Check with
# `ghostty +list-fonts --family="JetBrainsMono NFM"`.
font-family = JetBrainsMono NFM
font-size = 12

# New windows always start in the notebook vault. Without disabling
# window-inherit-working-directory, a new window would copy the focused
# window's directory instead. Splits and tabs still inherit their parent's
# directory (split-/tab-inherit-working-directory default to true).
working-directory = ~/vaults/notebook-personal
window-inherit-working-directory = false

# --- Shell integration / agent-friendly features ----------------------------
# ssh-env: map TERM to xterm-256color on remote hosts and forward
#   COLORTERM/TERM_PROGRAM. ssh-terminfo: install xterm-ghostty terminfo on
#   first connect (needs `tic` remotely, cached locally; see `ghostty +ssh-cache`).
# Other features keep their defaults (cursor, title, path on; sudo off).
shell-integration-features = ssh-env,ssh-terminfo

# Desktop notification + bell when a command running in an unfocused split/tab
# finishes after 10s+ (long builds, tests, agent shell jobs). Needs shell
# integration (OSC 133), which bash gets automatically.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify,bell
notify-on-command-finish-after = 10s

# Selecting text copies it to the system clipboard (Ctrl+V). Use `both` to also
# keep filling the middle-click primary selection.
copy-on-select = clipboard

# Restore windows/tabs/splits on relaunch. As of Ghostty 1.4 this is macOS-only
# and a no-op on Linux; kept so it takes effect if GTK support lands.
window-save-state = always

# --- Split navigation/resizing used by ghostlay (and by hand) ---------------
# Ghostty's defaults collide with KDE global shortcuts, which KWin grabs first:
#   ctrl+alt+arrows            -> KDE "Span Window"        (goto_split default)
#   super+ctrl+[ / ]           -> KDE "Rotate Windows"     (goto_split prev/next default)
#   super+ctrl+shift+arrows    -> KDE "Window One Desktop" (resize_split default)
# ctrl+alt+shift+* is unused by KDE and PlasmaZones, so splits live there.
keybind = ctrl+alt+shift+e=new_split:up
keybind = ctrl+alt+shift+arrow_left=goto_split:left
keybind = ctrl+alt+shift+arrow_right=goto_split:right
keybind = ctrl+alt+shift+arrow_up=goto_split:up
keybind = ctrl+alt+shift+arrow_down=goto_split:down
keybind = ctrl+alt+shift+[=goto_split:previous
keybind = ctrl+alt+shift+]=goto_split:next
keybind = ctrl+alt+shift+page_up=resize_split:up,10
keybind = ctrl+alt+shift+page_down=resize_split:down,10
keybind = ctrl+alt+shift+home=resize_split:left,10
keybind = ctrl+alt+shift+end=resize_split:right,10
keybind = ctrl+alt+shift+equal=equalize_splits
