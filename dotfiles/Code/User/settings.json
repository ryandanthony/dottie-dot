{
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontSize": 12,
    "editor.fontLigatures": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "debug.console.fontFamily": "JetBrainsMono Nerd Font",
    "debug.console.fontSize": 12,
    "git.confirmSync": false,
    "security.workspace.trust.untrustedFiles": "open",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.renderSideBySide": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "docker.extension.enableComposeLanguageServer": false,
    "vs-kubernetes": {
        "vs-kubernetes.crd-code-completion": "enabled"
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.mcp.autostart": "onlyNew",
    "chat.agent.maxRequests": 10000,
    "redhat.telemetry.enabled": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "vsicons.dontShowNewVersionMessage": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "git.autofetch": true,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://github.com/ryandanthony/dottie": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://ryandanthony.github.io": true,
        "https://github.com": true,
        "https://wolverine.netlify.app": true,
        "https://openfga.dev": true,
        "https://github.com/openfga": true,
        "https://natsbyexample.com": true,
        "https://docs.nats.io": true,
        "https://*.nats.io": true,
        "https://*.githubusercontent.com": true,
        "https://github.com/github/spec-kit": true,
        "https://github.com/github": true,
        "https://github.github.com/spec-kit": true,
        "https://github.github.com": true,
        "https://*.github.com": true,
        "https://speckit.org": true,
        "https://www.nuget.org": true,
        "https://*.nuget.org": true,
        "https://martendb.io": true,
        "https://docs.recipe-scrapers.com": true,
        "https://docs.avaloniaui.net": true,
        "https://netclaw.dev": true
    },
    "git.enableSmartCommit": true,
    "chat.viewSessions.orientation": "stacked",
    "chat.tools.terminal.autoApprove": {
        "dotnet build": true
    },
    "claudeCode.preferredLocation": "panel",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "workbench.colorTheme": "GitHub Dark Dimmed",
    "chat.disableAIFeatures": true,
    "claudeCode.useTerminal": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
}
