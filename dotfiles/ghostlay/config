delay = 0.5

# Keystrokes via ydotool (uinput) instead of wtype: KWin doesn't expose the
# Wayland virtual-keyboard protocol, so wtype fails on KDE Plasma.
# Requires /dev/uinput access (scripts/setup-uinput.sh). Key names are
# linux input event codes without the KEY_ prefix.
# `grep -v ydotoold` drops the harmless "ydotoold backend unavailable" notice
# (Ubuntu's ydotool 0.1.8 works fine without the daemon) but keeps real errors.
bind = v:ydotool key CTRL+SHIFT+O 2>&1 | grep -v ydotoold >&2
bind = h:ydotool key CTRL+SHIFT+E 2>&1 | grep -v ydotoold >&2
bind = n:ydotool key SUPER+CTRL+RIGHTBRACE 2>&1 | grep -v ydotoold >&2
bind = p:ydotool key SUPER+CTRL+LEFTBRACE 2>&1 | grep -v ydotoold >&2
bind = rr:ydotool key SUPER+CTRL+ALT+SHIFT+RIGHT 2>&1 | grep -v ydotoold >&2
bind = rl:ydotool key SUPER+CTRL+ALT+SHIFT+LEFT 2>&1 | grep -v ydotoold >&2
bind = ru:ydotool key SUPER+CTRL+ALT+SHIFT+UP 2>&1 | grep -v ydotoold >&2
bind = rd:ydotool key SUPER+CTRL+ALT+SHIFT+DOWN 2>&1 | grep -v ydotoold >&2
bind = cmd:{ ydotool type "$TOKEN" && ydotool key ENTER; } 2>&1 | grep -v ydotoold >&2

# Shorthand layout
dev = "nvim ." v opencode rr rr p h rd rd p

